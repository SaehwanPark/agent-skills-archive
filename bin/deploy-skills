#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
UV_BIN=${UV_BIN:-$(which uv 2>/dev/null || true)}

if [ -z "$UV_BIN" ]; then
  echo "error: uv binary was not found on PATH" >&2
  echo "install uv, add it to PATH, or set UV_BIN to the absolute path of uv" >&2
  exit 127
fi

if [ ! -x "$UV_BIN" ]; then
  echo "error: uv binary is not executable: $UV_BIN" >&2
  echo "set UV_BIN to the absolute path of uv" >&2
  exit 127
fi

exec "$UV_BIN" run --project "$REPO_ROOT" deploy-skills "$@"
